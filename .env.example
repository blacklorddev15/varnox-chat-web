# ============================================================================
# Varnox Chat - server environment.
#
# Each line below has an empty value waiting for one. Copy them from:
#   Vercel -> your project -> Settings -> Environment Variables
# (.env.example lists every variable the server reads; .env is the copy you upload.)
#
# This file contains no secrets. Never commit a filled-in copy to a public repo.
# ============================================================================

# ---------------------------------------------------------------- fill these in

# PostgreSQL connection string, including sslmode=require for hosted providers.
DATABASE_URL=

# Signs session tokens, at least 32 characters. Use the SAME value as the Vercel
# deployment: both servers share the database, and a different value signs out every
# existing user, because their year-long tokens were signed with the other secret.
JWT_SECRET=

# Voice and video calls. The call screens are already built; without these three they
# open and never connect. The server says so explicitly if they are missing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Verification and password-reset email. Blank means those emails are logged instead.
RESEND_API_KEY=

# Platform OAuth sign-in only. Password and phone sign-in do not use it.
VITE_APP_ID=

# ---------------------------------------------------------------- already set

# The first account, which is granted admin rights.
OWNER_OPEN_ID=blacklorddev

# Must be on a domain verified in Resend, or sends are rejected.
RESEND_FROM=Varnox Chat <no-reply@varnoxapp.blacklord.tech>

NODE_ENV=production

# ---------------------------------------------------------------- optional

# SMS verification. Without these, phone codes are logged rather than sent.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_BRAND=

# ---------------------------------------------------------------- leave alone

# PORT - set this if the console logs a port that differs from the Address in your panel,
# which means your panel is not supplying SERVER_PORT. The server reads PORT first, then
# SERVER_PORT, then falls back to 3000 - and 3000 will not match your allocation, so the
# panel's address answers nothing even though the log says it started.
#
# Use the port from your panel's Address field, e.g. if it shows  Jalia:25578  then:
#   PORT=25578
#
# Do NOT add VERCEL=1: when it is set the server deliberately does not listen at all,
# because on Vercel it is loaded as a function instead of owning the port.
#
# EXPO_PUBLIC_API_BASE_URL belongs in the *build* environment, not here - it is inlined
# into the web bundle, and setting it later changes nothing.
