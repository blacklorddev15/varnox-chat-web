# Varnox Chat - environment template.
#
# Copy to `.env` next to package.json (the server loads it with dotenv) and fill in the values.
# `.env` is gitignored; this template is not.
#
# On a Pterodactyl/Pelican server, create the file through the panel's file manager:
#   New File -> name it exactly ".env" -> paste the lines below -> Start the server.
# The panel supplies SERVER_PORT itself, so the port needs no configuring here.

# ---------------------------------------------------------------- required

# PostgreSQL. Include sslmode=require for hosted providers.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Signs session tokens. At least 32 characters. Changing it signs every user out, and a value that
# differs from another server's means users must sign in again when you switch between them.
JWT_SECRET=replace-with-at-least-32-random-characters

# The first account, which is granted admin rights.
OWNER_OPEN_ID=blacklorddev

# ---------------------------------------------------------------- email (optional)

# Without these, verification and password-reset emails are written to the log instead of sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or sends are rejected.
RESEND_FROM=Varnox Chat <no-reply@varnoxapp.blacklord.tech>

# ---------------------------------------------------------------- voice and video calls (optional)

# The calls UI is already built end to end; it needs these three to connect. Without them the
# call screens open and never connect.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- SMS verification (optional)

# Without these, phone verification codes are logged rather than sent.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_BRAND=

# ---------------------------------------------------------------- runtime (usually supplied by the host)

NODE_ENV=production
# Local development only. Pterodactyl injects SERVER_PORT; PORT wins if both are set.
# PORT=3000

# Do NOT set VERCEL. If VERCEL=1 the server deliberately does not listen at all, because on Vercel
# it is loaded as a function instead of owning the port.

# ---------------------------------------------------------------- not needed here

# These are inlined into the web bundle when it is built, so they belong in the build environment,
# not in a server .env. Set EXPO_PUBLIC_API_BASE_URL only if the API lives on a different host from
# the frontend, and remember it is baked in at build time - changing it later does nothing.
#
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
#
# BUILT_IN_FORGE_API_URL / BUILT_IN_FORGE_API_KEY point at a platform service, not something a
# self-hosted deployment can use. Media is stored in the database when they are absent.
